# ============================================================
# .gitignore — Multi-LLM Agents Orchestration (public)
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.venv-vector/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.trunk/
.jj/

# ---- Editor agent local settings ----
*settings.json
*settings.local.json

# ---- Working / scratch directories ----
.archive/
.plan/
.references/
.tmp/
plan/
.not-for-public/*

# ---- Internal / project-specific docs not for public ----
.requirements.md

# ---- Config state (generated per-environment) ----
*config-state.md
*config-state.yaml

# ---- Context Manager (project-specific data only) ----
.contexts/local/
.contexts/cache/
.contexts/exports/
.contexts/context.db

# ---- agentorch runtime data (project-specific, not tool code) ----
.agentorch/artifacts/
.agentorch/facts/probe-results/
.agentorch/state/
agentorch_ctx/artifacts/tasks/
agentorch_ctx/state/

# agentorch_ctx facts — keep READMEs and static seed files, exclude runtime probe/env data
agentorch_ctx/facts/**/*.json
agentorch_ctx/facts/*.json
!agentorch_ctx/facts/verified-facts/imported-seed.json
!agentorch_ctx/facts/validation-debt.json
!agentorch_ctx/facts/provider-market-facts/bootstrap.json
