{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["target_kind", "match_pattern", "enforcement"],
  "properties": {
    "target_kind": {
      "type": "string",
      "enum": ["command", "file_operation", "network", "vcs", "tool", "any"]
    },
    "match_pattern": { "type": "string" },
    "enforcement": { "type": "string", "enum": ["warn", "confirm", "deny"] },
    "rationale": { "type": "string" },
    "allowed_when": { "type": "string" },
    "requires_human_approval": { "type": "boolean" }
  },
  "additionalProperties": true
}
