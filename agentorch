#!/usr/bin/env bash
# agentorch — entry point wrapper for the agentorch-ctx CLI.
# Works both when installed via pip (python -m agentorch_ctx) and
# when running directly from the source checkout.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m agentorch_ctx "$@"
