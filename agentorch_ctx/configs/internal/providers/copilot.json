    "noAskUserFlag": "--no-ask-user",
    "modelFlag": "--model",
    "resumeFlag": "--resume",
    "continueFlag": "--continue",
    "noColorFlag": "--no-color"
  },
  "capabilityRefs": [
    "session.resume",
    "output.plain_text",
    "execution.working_dir_persistence"
