{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agentorch/configs/schemas/phase.schema.json",
  "title": "Phase User Config",
  "description": "Per-phase defaults and overrides. Specify optional phase-level defaults, strategy-level defaults, and per-step provider/model/effort overrides.",
  "type": "object",
  "required": ["version", "phase"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "phase": {
      "type": "string",
      "enum": ["plan", "impl", "review", "harden"]
    },
    "$presets": {
      "type": "object",
      "description": "Named step configs for reuse. Reference via '$preset' in phase-level defaults, strategy-level defaults, or step-level overrides.",
      "additionalProperties": { "$ref": "#/definitions/stepConfig" }
    },
    "default": {
      "$ref": "#/definitions/stepConfig",
      "description": "Optional phase-wide fallback applied to all strategies and steps in this phase."
    },
    "strategies": {
      "type": "object",
      "description": "Map of strategyId to strategy overrides. Only listed strategies are affected; others use defaults.",
      "additionalProperties": { "$ref": "#/definitions/strategyConfig" }
    }
  },
  "definitions": {
    "strategyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Set false to disable this strategy from being selected. Default: true.",
          "default": true
        },
        "default": {
          "$ref": "#/definitions/stepConfig",
          "description": "Optional fallback applied to all steps in this strategy."
        },
        "steps": {
          "type": "object",
          "description": "Map of step ID to step config. Only listed steps are overridden.",
          "additionalProperties": { "$ref": "#/definitions/stepConfig" }
        }
      }
    },
    "stepConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "IMPORTANT: Put 'provider' before 'model' to get IDE autocomplete for model names.",
      "properties": {
        "$preset": {
          "type": "string",
          "description": "Reference a named preset from $presets. Explicit keys in this step override preset values."
        },
        "provider": {
          "type": "string",
          "enum": ["codex", "copilot", "gemini"],
          "description": "Provider for this step. Write this FIRST for model autocomplete to work."
        },
        "model": {
          "type": "string",
          "description": "Model ID. Valid values depend on provider. See per-provider branches below via if/then."
        },
        "effort": {
          "type": "string",
          "enum": ["minimal", "low", "mid", "medium", "high", "xhigh"],
          "description": "Reasoning effort. codex: low/mid/high/xhigh. copilot: low/medium/high/xhigh. gemini: minimal/low/medium/high via GEMINI_CLI_SYSTEM_SETTINGS_PATH custom alias."
        }
      },
      "if": {
        "properties": { "provider": { "const": "codex" } },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "model": {
            "enum": [
              "gpt-5.4",
              "gpt-5.3-codex",
              "gpt-5.2-codex",
              "gpt-5.2",
              "gpt-5.1-codex-max",
              "gpt-5.1-codex-mini"
            ]
          },
          "effort": { "enum": ["low", "mid", "high", "xhigh"] }
        }
      },
      "else": {
        "if": {
          "properties": { "provider": { "const": "copilot" } },
          "required": ["provider"]
        },
        "then": {
          "properties": {
            "model": {
              "enum": [
                "claude-sonnet-4.6",
                "claude-sonnet-4.5",
                "claude-haiku-4.5",
                "claude-opus-4.6",
                "claude-opus-4.5",
                "claude-sonnet-4",
                "gemini-3-pro-preview",
                "gpt-5.4",
                "gpt-5.3-codex",
                "gpt-5.2-codex",
                "gpt-5.2",
                "gpt-5.1-codex-max",
                "gpt-5.1-codex",
                "gpt-5.1",
                "gpt-5.1-codex-mini",
                "gpt-5-mini",
                "gpt-4.1"
              ]
            },
            "effort": { "enum": ["low", "medium", "high", "xhigh"] }
          }
        },
        "else": {
          "if": {
            "properties": { "provider": { "const": "gemini" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "model": {
                "enum": [
                  "gemini-2.5-pro",
                  "gemini-3.1-pro-preview",
                  "gemini-3-pro-preview",
                  "gemini-3-flash-preview",
                  "gemini-2.5-flash",
                  "gemini-2.5-flash-lite",
                  "auto",
                  "pro",
                  "flash",
                  "flash-lite"
                ]
              },
              "effort": { "enum": ["minimal", "low", "medium", "high"] }
            }
          }
        }
      }
    }
  }
}
