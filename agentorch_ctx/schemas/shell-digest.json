{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentorch/schemas/shell-digest.json",
  "title": "Collab Shell Digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "concise_summary",
    "facts",
    "warnings",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "partial",
        "failed",
        "blocked",
        "stalled"
      ]
    },
    "concise_summary": {
      "type": "string",
      "maxLength": 1024
    },
    "stop_reason": {
      "type": "string"
    },
    "resume_hint": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "status"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["declared", "observed", "verified"]
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shell_digest_ref": {
          "type": "string"
        },
        "execution_record_ref": {
          "type": "string"
        },
        "response_ref": {
          "type": "string"
        },
        "validation_ref": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
