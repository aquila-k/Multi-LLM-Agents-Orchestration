#!/usr/bin/env bash
# agentorch_ctx/run — entry point wrapper for the agentorch_ctx runtime CLI.
#
# Always resolves the repo root from this script's own location,
# regardless of the caller's current working directory.
# Adds the repo root to PYTHONPATH so `python3 -m agentorch_ctx` works from anywhere.
#
# Usage (same as python3 -m agentorch_ctx):
#   agentorch_ctx/run plan   --source /abs/path/to/goal.md
#   agentorch_ctx/run impl   --source /abs/path/to/task.json
#   agentorch_ctx/run review --source /abs/path/to/criteria.md
#   agentorch_ctx/run harden --source /abs/path/to/criteria.md
#   agentorch_ctx/run review --source /abs/path/to/criteria.md --with-harden
#   agentorch_ctx/run plan   --source /abs/path/to/goal.md     --dry-run

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m agentorch_ctx "$@"
