#!/usr/bin/env bash
# collab/run — entry point wrapper for the collab runtime CLI.
#
# Always resolves the repo root from this script's own location,
# regardless of the caller's current working directory.
# Adds the repo root to PYTHONPATH so `python3 -m collab` works from anywhere.
#
# Usage (same as python3 -m collab):
#   collab/run plan   --source /abs/path/to/goal.md
#   collab/run impl   --source /abs/path/to/task.json
#   collab/run review --source /abs/path/to/criteria.md
#   collab/run harden --source /abs/path/to/criteria.md
#   collab/run review --source /abs/path/to/criteria.md --with-harden
#   collab/run plan   --source /abs/path/to/goal.md     --dry-run

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m collab "$@"
