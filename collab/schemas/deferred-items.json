{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeferredItems",
  "type": "object",
  "required": ["schemaVersion", "taskId", "phase", "items"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "reason"],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "expectedResolutionPhase": {
            "type": "string"
          }
        }
      }
    },
    "extractedFrom": {
      "type": "string"
    }
  }
}
