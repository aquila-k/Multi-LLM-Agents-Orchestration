{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collab/schemas/response.json",
  "title": "Collab Provider Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "mode",
    "summary",
    "warnings",
    "issues",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed", "blocked"]
    },
    "mode": {
      "$ref": "#/$defs/outputMode"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "default": []
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "default": []
    },
    "raw_output_ref": {
      "type": "string"
    },
    "parsed_payload_ref": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter_version",
        "started_at",
        "completed_at",
        "run_ref"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_ref": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "shell_digest_ref": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "outputMode": {
      "type": "string",
      "enum": [
        "patch",
        "create_file",
        "full_file",
        "mixed",
        "rename_file",
        "delete_file",
        "binary_patch",
        "report_only"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "artifact_ref": {
          "type": "string"
        }
      }
    }
  }
}
