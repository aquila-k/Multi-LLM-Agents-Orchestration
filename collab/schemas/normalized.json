{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collab/schemas/normalized.json",
  "title": "Collab Normalized Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "mode",
    "payload_family",
    "safety",
    "validation_summary",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "partial",
        "failed_but_meaningful",
        "failed_unusable",
        "blocked"
      ]
    },
    "mode": {
      "$ref": "#/$defs/outputMode"
    },
    "payload_family": {
      "type": "string",
      "enum": [
        "operations",
        "findings",
        "recommendations",
        "reports",
        "condensed_context"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      },
      "default": []
    },
    "approved_operations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "default": []
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "default": []
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "default": []
    },
    "condensed_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "default": []
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_operator_review", "scope_check", "confidence"],
      "properties": {
        "requires_operator_review": {
          "type": "boolean"
        },
        "scope_check": {
          "type": "string",
          "enum": ["passed", "failed", "unknown"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "passed_with_warnings",
            "failed_but_meaningful",
            "failed_unusable"
          ]
        },
        "validation_ref": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_response_ref", "normalizer_version", "created_at"],
      "properties": {
        "source_response_ref": {
          "type": "string",
          "minLength": 1
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "outputMode": {
      "type": "string",
      "enum": [
        "patch",
        "create_file",
        "full_file",
        "mixed",
        "rename_file",
        "delete_file",
        "binary_patch",
        "report_only"
      ]
    },
    "record": {
      "type": "object",
      "required": ["id", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "target_path",
        "mode",
        "base_fingerprint",
        "expected_existing_path_state",
        "risk_level",
        "requires_approval",
        "scope_check",
        "confidence",
        "source_run_refs",
        "validation_refs",
        "estimated_changed_lines",
        "estimated_changed_bytes"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "#/$defs/outputMode"
        },
        "base_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "expected_existing_path_state": {
          "type": "string",
          "minLength": 1
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "requires_approval": {
          "type": "boolean"
        },
        "scope_check": {
          "type": "string",
          "enum": ["passed", "failed", "unknown"]
        },
        "danger_class": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_run_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "content": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "estimated_changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_changed_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
