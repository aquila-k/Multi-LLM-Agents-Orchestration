{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collab/schemas/known-information.json",
  "title": "Collab Known Information Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "user_goal_summary",
    "confirmed_constraints",
    "accepted_assumptions",
    "rejected_options",
    "unresolved_blockers",
    "source_references",
    "latest_phase_summary",
    "latest_validation_apply_summary",
    "latest_shell_digestion_summary",
    "entries",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "user_goal_summary": {
      "type": "string"
    },
    "confirmed_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "accepted_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "rejected_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "reference",
              "validation",
              "shell_digest",
              "operator"
            ]
          }
        }
      },
      "default": []
    },
    "latest_phase_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "summary"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["plan", "impl", "review", "harden"]
        },
        "summary": {
          "type": "string"
        },
        "artifact_ref": {
          "type": "string"
        }
      }
    },
    "latest_validation_apply_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "validation_ref": {
          "type": "string"
        },
        "apply_result_ref": {
          "type": "string"
        }
      }
    },
    "latest_shell_digestion_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "shell_digest_ref": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "status",
          "source",
          "updated_at",
          "affects"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": true,
          "status": {
            "type": "string",
            "enum": ["declared", "observed", "verified", "superseded"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supersedes": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
