{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "question.json",
  "title": "Question Artifact",
  "description": "Machine-readable question artifact for async clarification. Generated only when explicitly requested by the user.",
  "type": "object",
  "required": ["schemaVersion", "taskId", "phase", "questions"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": ["plan", "impl", "review", "harden"]
    },
    "step": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "description": "The question to present to the user."
          },
          "reason": {
            "type": "string",
            "description": "Why this question needs to be answered."
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "description"],
              "properties": {
                "label": { "type": "string" },
                "description": { "type": "string" },
                "recommended": { "type": "boolean", "default": false }
              }
            },
            "description": "Structured choices for the question. Prefer providing choices when possible."
          },
          "allowFreeform": {
            "type": "boolean",
            "default": true,
            "description": "Whether free-form text is accepted as an answer."
          },
          "answer": {
            "type": "string",
            "description": "User's answer, filled in after the question is answered."
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "partially_answered", "answered"],
      "default": "pending"
    }
  }
}
